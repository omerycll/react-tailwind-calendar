{
  "name": "react-tailwind-calendar",
  "version": "1.0.2",
  "description": "A flexible and customizable big calendar component for React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && cp src/styles.css dist/styles.css",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "calendar",
    "big-calendar",
    "schedule",
    "events",
    "tailwind",
    "tailwindcss"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omerycll/react-tailwind-calendar.git"
  },
  "homepage": "https://react-tailwind-calendar-nu.vercel.app/",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "date-fns": "^3.0.0",
    "@remixicon/react": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "date-fns": "^3.0.0",
    "@remixicon/react": "^4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  }
}
